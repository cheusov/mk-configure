#!@SH@
# -*- mode: sh; -*-

set -e

export compiler_settings=1
: ${MAKEOBJDIR:=$HOME/.mkcmake}
export MAKEOBJDIR
export MKC_CACHEDIR="$MAKEOBJDIR"
export MKC_NOCACHE=1
: ${MK_FILES_DIR:=@mkfilesdir@}
: ${FEATURESDIR:=@featuresdir@}
export COMPILER_SETTINGS_MK="-f $MK_FILES_DIR/mkc.compiler_settings.mk"
export SRCTOP=/baddir

BMAKE=${MKC_BMAKE-@BMAKE@}

: ${CC:=cc}
: ${CXX:=c++}

: ${USE_CC_COMPILERS:=${CC}}
: ${USE_CXX_COMPILERS:=${CXX}}

unset CC
unset CXX

for CC in ${USE_CC_COMPILERS}; do
    env CC="$CC" CXX= src_type=cc $BMAKE -m "$MK_FILES_DIR" -m "$FEATURESDIR" $COMPILER_SETTINGS_MK FEATURESDIR="$FEATURESDIR" all
done
for CXX in ${USE_CXX_COMPILERS}; do
    env CXX="$CXX" CC= src_type=cxx $BMAKE -m "$MK_FILES_DIR" -m "$FEATURESDIR" $COMPILER_SETTINGS_MK FEATURESDIR="$FEATURESDIR" all
done
